{
  "name": "spellweb",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run dev:api & npm run dev:web",
    "dev:api": "node --no-warnings --import tsx src/server/app.ts",
    "dev:web": "vite",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "sync:cards": "node --no-warnings --import tsx src/cli/sync-cards.ts",
    "sync:rules": "node --no-warnings --import tsx src/cli/sync-rules.ts",
    "generate:atom-schema": "node --no-warnings --import tsx src/cli/generate-atom-schema.ts",
    "golden": "node --no-warnings --import tsx src/cli/golden.ts",
    "golden:draft": "node --no-warnings --import tsx src/cli/golden-draft.ts",
    "kernel:derive": "node --no-warnings --import tsx src/cli/derive-kernel.ts",
    "extract": "node --no-warnings --import tsx src/cli/extract-atoms.ts",
    "packet-check": "node --no-warnings --import tsx src/cli/packet-check.ts",
    "batch:select": "node --no-warnings --import tsx src/cli/select-batch.ts",
    "edge-rules": "node --no-warnings --import tsx src/cli/edge-rules.ts",
    "edge-golden": "node --no-warnings --import tsx src/cli/edge-golden.ts",
    "graph": "node --no-warnings --import tsx src/cli/graph.ts",
    "duplicate-rules": "node --no-warnings --import tsx src/cli/duplicate-rules.ts",
    "link-check": "node --no-warnings --import tsx src/cli/link-check.ts",
    "tag-describe": "node --no-warnings --import tsx src/cli/tag-describe.ts",
    "tag-check": "node --no-warnings --import tsx src/cli/tag-check.ts",
    "run-compare": "node --no-warnings --import tsx src/cli/run-compare.ts",
    "trigger-gap": "node --no-warnings --max-old-space-size=8192 --import tsx src/cli/trigger-gap.ts",
    "owner-questions": "node --no-warnings --import tsx src/cli/owner-questions.ts",
    "golden-check": "node --no-warnings --import tsx src/cli/golden-check.ts",
    "cr-duplicates": "node --no-warnings --import tsx src/cli/cr-duplicates.ts",
    "cr-debate": "node --no-warnings --import tsx src/cli/cr-debate.ts",
    "rate-groups": "node --no-warnings --import tsx src/cli/rate-groups.ts",
    "rate-fields": "node --no-warnings --import tsx src/cli/rate-fields.ts",
    "rate-proof": "node --no-warnings --max-old-space-size=8192 --import tsx src/cli/rate-proof.ts",
    "rate-fit": "node --no-warnings --max-old-space-size=8192 --import tsx src/cli/rate-fit.ts",
    "deck": "node --no-warnings --max-old-space-size=8192 --import tsx src/cli/deck.ts",
    "link-apply": "node --no-warnings --import tsx src/cli/link-apply.ts",
    "game-scan": "node --no-warnings --import tsx src/cli/game-scan.ts",
    "build-diff": "node --no-warnings --max-old-space-size=8192 --import tsx src/cli/build-diff.ts",
    "test:db": "vitest run --config vitest.db.config.ts",
    "seed:atom-schema": "node --no-warnings --import tsx src/cli/seed-atom-schema.ts"
  },
  "dependencies": {
    "@fastify/static": "^10.1.2",
    "fastify": "^5.10.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.0.0",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "vite": "^6.4.3",
    "vitest": "^3.2.7"
  }
}
