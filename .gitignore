!data/cr-debate/
data/cr-debate/*
!data/cr-debate/verdicts.json
!data/cr-debate/round-*/
data/cr-debate/round-*/*
!data/cr-debate/round-*/answers.json
!data/cr-debate/round-*/manifest.json
dist/
*.log

